# Copia este fichero a .env y cambia los valores.

# Clave para firmar los tokens. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Duración de la sesión en horas.
JWT_EXPIRES_HOURS=24

# Base de datos SQLite dentro del volumen de Docker.
DATABASE_URL=sqlite:////data/convive.db

# Orígenes permitidos por CORS (solo si usas `npm run dev` contra el backend en Docker).
# Con Nginx no hace falta: frontend y API comparten origen.
CORS_ORIGINS=
